# ---- Judge model: any OpenAI-compatible endpoint ----
# Local Ollama (default)
JUDGE_BASE_URL=http://localhost:11434/v1
JUDGE_API_KEY=ollama
JUDGE_MODEL=qwen2.5:14b-instruct

# Examples for the real evaluation (uncomment one):
# JUDGE_BASE_URL=https://openrouter.ai/api/v1
# JUDGE_API_KEY=sk-or-...
# JUDGE_MODEL=qwen/qwen-2.5-72b-instruct
#
# JUDGE_BASE_URL=https://api.openai.com/v1
# JUDGE_API_KEY=sk-...
# JUDGE_MODEL=gpt-4o

JUDGE_TEMPERATURE=0
JUDGE_SAMPLES=1
JUDGE_MAX_RETRIES=3
JUDGE_TIMEOUT=300
# json_schema | json_mode | function_calling  (use json_mode if a provider rejects json_schema)
JUDGE_STRUCTURED=json_schema
JUDGE_USE_GLOSSARY=1

# ---- Data (relative to llm-judge/) ----
TRANSLATE_IN_FILE=../multilingual-assistant/translate_in.json
TRANSLATE_OUT_FILE=../multilingual-assistant/translate_out.json
RESULTS_DIR=results

# ---- Scoring ----
MQM_WEIGHTS=minor:1,major:5,critical:10
PASS_MAX_PENALTY=5
